            "size": 4723,
            "mimeType": "text/html",
            "text": "<!doctype html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <title>ESPro Student Portal - CUE | CHRIST (Deemed to be University)</title>\r\n  <meta name=\"google-site-verification\" content=\"quUbJK-GWWRyH8SSy127fAXrHqNttEX9K4EvPN-bdKs\" />\r\n  <link rel=\"icon\"\r\n    href=\"https://prod-espro-public.s3.ap-south-1.amazonaws.com/images/General_Images/espro_logo_small.png\" />\r\n  <meta name=\"description\"\r\n    content=\"Welcome to CUE (Campus Unified Experience), the official ESPro student portal of CHRIST (Deemed to be University). Log in to your Christ University student portal to access attendance, marks, and university services.\" />\r\n  <meta name=\"keywords\"\r\n    content=\"espro, espro student portal, christ university, christ university student portal, CUE, Campus unified experience, christ student portal\" />\r\n  <link rel=\"canonical\" href=\"https://cue.christuniversity.in/\" />\r\n\r\n  <!-- Open Graph / Facebook -->\r\n  <meta property=\"og:type\" content=\"website\" />\r\n  <meta property=\"og:url\" content=\"https://cue.christuniversity.in/\" />\r\n  <meta property=\"og:title\" content=\"ESPro Student Portal - CUE | CHRIST (Deemed to be University)\" />\r\n  <meta property=\"og:description\"\r\n    content=\"Welcome to CUE (Campus Unified Experience), the official ESPro student portal of CHRIST (Deemed to be University). Log in to your Christ University student portal to access attendance, marks, and university services.\" />\r\n  <meta property=\"og:image\"\r\n    content=\"https://prod-espro-public.s3.ap-south-1.amazonaws.com/images/General_Images/espro_logo_small.png\" />\r\n  <meta property=\"og:site_name\" content=\"ESPro Student Portal\" />\r\n\r\n  <!-- Twitter -->\r\n  <meta name=\"twitter:card\" content=\"summary\" />\r\n  <meta name=\"twitter:url\" content=\"https://cue.christuniversity.in/\" />\r\n  <meta name=\"twitter:title\" content=\"ESPro Student Portal - CUE | CHRIST (Deemed to be University)\" />\r\n  <meta name=\"twitter:description\"\r\n    content=\"Welcome to CUE (Campus Unified Experience), the official ESPro student portal of CHRIST (Deemed to be University).\" />\r\n  <meta name=\"twitter:image\"\r\n    content=\"https://prod-espro-public.s3.ap-south-1.amazonaws.com/images/General_Images/espro_logo_small.png\" />\r\n  <link rel=\"apple-touch-icon\"\r\n    href=\"https://prod-espro-public.s3.ap-south-1.amazonaws.com/images/General_Images/espro_logo_small.png\" />\r\n  <!-- Smart App Banner — prompts iOS users (Safari & Chrome) to open in native CUE app -->\r\n  <meta name=\"apple-itunes-app\" content=\"app-id=6776622967\" />\r\n  <meta name=\"viewport\"\r\n    content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, viewport-fit=cover\" />\r\n  <script>\r\n    document.write('<script src=\"/config.js?v=' + new Date().getTime() + '\"><\\/script>');\r\n  </script>\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap\"\r\n    rel=\"stylesheet\" />\r\r\n\r\n  <!-- Content Security Policy — XSS mitigation -->\r\n  <!-- Restricts script sources to 'self' only. Allows connections to Keycloak + API. -->\r\n  <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self';\r\n             script-src 'self' blob: https://*.billdesk.com https://*.grayquest.com https://*.graydev.tech;\r\n             style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.billdesk.com;\r\n             font-src 'self' https://fonts.gstatic.com;\r\n             img-src 'self' data: https: blob:;\r\n             connect-src 'self' http://localhost:* ws://localhost:* http://10.5.13.53:* ws://10.5.13.53:* https://*.christuniversity.in:* https://*.christuniversity.in wss://*.christuniversity.in:* https://fonts