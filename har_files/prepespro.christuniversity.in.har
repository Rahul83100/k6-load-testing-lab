            "text": ".offline-hostel-appln-card-style{border-top:3px solid #3c8dbc;background-color:#fff;border-left:1px solid rgba(128,128,128,.342);border-right:1px solid rgba(128,128,128,.342);border-bottom:1px solid rgba(128,128,128,.342);border-top-left-radius:7px;border-top-right-radius:7px;box-shadow:0 0 1px #00000096;padding:6px;overflow:hidden}.offline-hostel-appln-card-div-container{margin:3px;padding:9px;justify-content:center;align-items:center}.button-Hover-effect:hover{background-color:red;color:#fff}.offline-hostel-appln-to-hostel{border-top:4px solid #679fe9;background-color:#fff;border-left:1px solid rgba(128,128,128,.342);border-right:1px solid rgba(128,128,128,.342);border-bottom:1px solid rgba(128,128,128,.342)}.offline_hostelApplication__Heading{font-size:18px;font-weight:600;margin-bottom:15px;color:#2c3e50;background:#d5edf985;padding:8px 12px;border-left:4px solid #3498db;border-radius:4px}.hostelPillToggle{position:relative;width:100%;max-width:430px;height:38px;background:#e9ecef;border-radius:40px;padding:3px;display:flex;align-items:center;border:1px solid #d0d7dd;overflow:hidden}.hostelPillToggle .pill-slider{position:absolute;top:3px;left:3px;width:calc(50% - 3px);height:calc(100% - 6px);background:#1976d2;border-radius:40px;transition:transform .25s ease;z-index:1}.hostelPillToggle .MuiToggleButton-root{flex:1;z-index:2;border:none!important;background:transparent!important;text-transform:none!important;font-size:.87rem;font-weight:500;color:#6c757d;padding:0 8px;display:flex;justify-content:center;align-items:center}.hostelPillToggle .Mui-selected{color:#fff!important;font-weight:600!important}.hostelPillToggle .info-icon{display:inline-flex;align-items:center;margin-left:6px}.hostelPillToggle .info-icon svg{color:#6c757d!important;fill:#6c757d!important;z-index:3}.hostelPillToggle .Mui-selected .info-icon svg{color:#fff!important;fill:#fff!important;z-index:3}.hostelApplicationWrapper{background:#fff;border:1px solid #e5e7eb;border-radius:10px!important;padding:1.75rem 2rem!important;box-shadow:0 2px 8px #0000000d;max-width:1250px!important}@media (max-width: 1099px){.hostelApplicationWrapper{max-width:100%!important;width:100%!important;padding:0}}@media (min-width: 1500px){.hostelApplicationWrapper{margin-left:auto!important;margin-right:auto!important}}\n"
